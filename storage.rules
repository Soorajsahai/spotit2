rules_version = '2';
// Firebase Storage rules for SpotIt app
// Allow uploads to reports/, issue_images/, and posts/
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{allPaths=**} {
      allow read, write: if true;
    }
    match /issue_images/{allPaths=**} {
      allow read, write: if true;
    }
    match /posts/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
